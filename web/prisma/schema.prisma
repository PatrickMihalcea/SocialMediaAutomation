// Bridge88 — schema.
// Every tenant-scoped row carries workspaceId and is indexed on it; authorization
// is derived from the session server-side (see src/lib/auth/guard.ts), never from
// a client-supplied workspace id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Pooled in production. Serverless functions each open their own
  /// connections, and a free Postgres tier runs out of them long before it
  /// runs out of anything else.
  url      = env("DATABASE_URL")
  /// Unpooled, for migrations only. Prisma takes an advisory lock while
  /// migrating, which does not survive a transaction pooler — so pointing
  /// `migrate deploy` at the pooled URL fails or hangs. Locally both are the
  /// same Postgres and this just points at it twice.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  MOCK
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
  DISCONNECTED
}

enum PostStatus {
  DRAFT
  REJECTED
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PostPlatformStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
  AUDIO
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiMediaJobKind {
  IMAGE_GENERATE
  IMAGE_EDIT
  IMAGE_VARIATION
  VIDEO_GENERATE
  VIDEO_ANIMATE
  AUDIO_TTS
  AUDIO_TRANSCRIBE
  AUDIO_TRANSLATE
}

enum QueueName {
  POST_PUBLISHING
  WORKFLOW
  MEDIA_PROCESSING
  THUMBNAIL_GENERATION
  ANALYTICS_SYNC
  NOTIFICATION
  AI_GENERATION
  RECURRENCE_EXPANSION
}

enum NotificationType {
  POST_PUBLISHED
  POST_FAILED
  OAUTH_EXPIRED
  APPROVAL_REQUESTED
  APPROVAL_COMPLETED
  MEDIA_PROCESSING_COMPLETE
  AI_GENERATION_COMPLETE
  MEMBER_JOINED
  LIMIT_REACHED
}

enum ApprovalDecision {
  COMMENT
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum AiOperation {
  CAPTION
  REWRITE
  HASHTAGS
  IDEAS
  IMAGE
  IMAGE_EDIT
  VIDEO
  AUDIO
  PLATFORM_ADAPTATION
  CHAT
  CALENDAR
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum DefaultPostDestination {
  DRAFT
  QUEUE
  SCHEDULE
}

enum AiCreativity {
  PRECISE
  BALANCED
  CREATIVE
}

// ---------------------------------------------------------------- identity

model User {
  id                                    String          @id @default(uuid()) @db.Uuid
  email                                 String          @unique
  name                                  String?
  image                                 String?
  passwordHash                          String?         @map("password_hash")
  emailVerified                         DateTime?       @map("email_verified")
  isPlatformAdmin                       Boolean         @default(false) @map("is_platform_admin")
  notificationEmailEnabled              Boolean         @default(true) @map("notification_email_enabled")
  notificationInAppEnabled              Boolean         @default(true) @map("notification_in_app_enabled")
  notificationApprovalsEnabled          Boolean         @default(true) @map("notification_approvals_enabled")
  notificationPublishingFailuresEnabled Boolean         @default(true) @map("notification_publishing_failures_enabled")
  notificationWeeklyDigestEnabled       Boolean         @default(false) @map("notification_weekly_digest_enabled")
  themePreference                       ThemePreference @default(SYSTEM) @map("theme_preference")
  lastLoginAt                           DateTime?       @map("last_login_at")
  createdAt                             DateTime        @default(now()) @map("created_at")
  updatedAt                             DateTime        @updatedAt @map("updated_at")

  accounts              Account[]
  sessions              Session[]
  memberships           WorkspaceMember[]
  posts                 Post[]
  mediaAssets           MediaAsset[]
  notifications         Notification[]
  approvalComments      ApprovalComment[]
  aiConversations       AiConversation[]
  aiGenerations         AiGeneration[]
  auditLogs             AuditLog[]
  invitesSent           WorkspaceInvite[] @relation("InviteInviter")
  workflowsCreated      Workflow[]
  workflowRunsTriggered WorkflowRun[]
  oauthAttempts         OAuthAttempt[]
  oauthSelections       OAuthSelection[]
  savedSearchViews      SavedSearchView[]

  @@index([createdAt])
  @@map("users")
}

/// Auth.js OAuth account linkage (Google). Distinct from SocialAccount, which is
/// a publishing target rather than a sign-in identity.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Single-use tokens for email verification and password reset. Stored hashed.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  purpose   String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------- tenancy

model Workspace {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  description     String?
  website         String?
  logoUrl         String?   @map("logo_url")
  industry        String?
  targetAudience  String?   @map("target_audience")
  timezone        String    @default("UTC")
  defaultLanguage String    @default("en") @map("default_language")
  onboardingStep  Int       @default(1) @map("onboarding_step")
  onboardedAt     DateTime? @map("onboarded_at")
  logoStorageKey  String?   @map("logo_storage_key")
  /// Pausing holds the queue: existing slots keep their times, nothing new is
  /// assigned, and due posts are not published until it resumes.
  queuePaused     Boolean   @default(false) @map("queue_paused")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  members            WorkspaceMember[]
  invites            WorkspaceInvite[]
  brandSettings      BrandSettings?
  preferences        WorkspacePreferences?
  socialAccounts     SocialAccount[]
  posts              Post[]
  mediaAssets        MediaAsset[]
  mediaFolders       MediaFolder[]
  mediaTags          MediaTag[]
  campaigns          Campaign[]
  schedulingRules    SchedulingRule[]
  queueItems         QueueItem[]
  recurringSchedules RecurringSchedule[]
  analyticsSnapshots AnalyticsSnapshot[]
  notifications      Notification[]
  aiConversations    AiConversation[]
  aiGenerations      AiGeneration[]
  aiMediaJobs        AiMediaJob[]
  subscription       Subscription?
  usageRecords       UsageRecord[]
  jobs               Job[]
  auditLogs          AuditLog[]
  workflows          Workflow[]
  workflowNodes      WorkflowNode[]
  workflowEdges      WorkflowEdge[]
  workflowRuns       WorkflowRun[]
  workflowNodeRuns   WorkflowNodeRun[]
  oauthAttempts      OAuthAttempt[]
  oauthSelections    OAuthSelection[]
  savedSearchViews   SavedSearchView[]

  @@index([createdAt])
  @@map("workspaces")
}

model WorkspacePreferences {
  workspaceId              String                 @id @map("workspace_id") @db.Uuid
  defaultPostDestination   DefaultPostDestination @default(DRAFT) @map("default_post_destination")
  defaultPublishHour       Int                    @default(9) @map("default_publish_hour")
  defaultPublishMinute     Int                    @default(0) @map("default_publish_minute")
  requireApprovalByDefault Boolean                @default(false) @map("require_approval_by_default")
  defaultHashtags          String[]               @default([]) @map("default_hashtags")
  defaultCta               String                 @default("") @map("default_cta")
  aiCreativity             AiCreativity           @default(BALANCED) @map("ai_creativity")
  aiUseBrandVoice          Boolean                @default(true) @map("ai_use_brand_voice")
  aiAutoAdaptPlatforms     Boolean                @default(true) @map("ai_auto_adapt_platforms")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_preferences")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole @default(EDITOR)
  tokenHash   String        @unique @map("token_hash")
  invitedById String        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("workspace_invites")
}

model BrandSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  workspaceId            String   @unique @map("workspace_id") @db.Uuid
  tone                   String?
  personality            String?
  targetAudience         String?  @map("target_audience")
  writingStyle           String?  @map("writing_style")
  wordsToUse             String[] @default([]) @map("words_to_use")
  wordsToAvoid           String[] @default([]) @map("words_to_avoid")
  emojiPolicy            String   @default("SPARING") @map("emoji_policy")
  hashtagPolicy          String   @default("MODERATE") @map("hashtag_policy")
  ctaStyle               String?  @map("cta_style")
  additionalInstructions String?  @map("additional_instructions")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

// ---------------------------------------------------------------- channels

model SocialAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @map("workspace_id") @db.Uuid
  platform              Platform
  accountName           String              @map("account_name")
  accountHandle         String?             @map("account_handle")
  /// The platform's own id for this account/page/channel.
  externalAccountId     String              @map("external_account_id")
  avatarUrl             String?             @map("avatar_url")
  /// AES-256-GCM ciphertext. Never leaves the server; see src/lib/crypto/tokens.ts.
  accessTokenEncrypted  String?             @map("access_token_encrypted")
  refreshTokenEncrypted String?             @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?           @map("token_expires_at")
  scopes                String[]            @default([])
  status                SocialAccountStatus @default(ACTIVE)
  statusMessage         String?             @map("status_message")
  lastSyncedAt          DateTime?           @map("last_synced_at")
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postPlatforms PostPlatform[]
  snapshots     AnalyticsSnapshot[]

  @@unique([workspaceId, platform, externalAccountId])
  @@index([workspaceId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@map("social_accounts")
}

/// Short-lived, single-use OAuth handshake. Only a SHA-256 state hash is stored.
model OAuthAttempt {
  id                    String    @id @default(uuid()) @db.Uuid
  stateHash             String    @unique @map("state_hash")
  userId                String    @map("user_id") @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  platform              Platform
  redirectUri           String    @map("redirect_uri")
  codeVerifierEncrypted String?   @map("code_verifier_encrypted")
  reconnectAccountId    String?   @map("reconnect_account_id") @db.Uuid
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([workspaceId, platform])
  @@index([expiresAt])
  @@map("oauth_attempts")
}

/// Encrypted callback results awaiting an explicit account/page choice.
model OAuthSelection {
  id                 String    @id @default(uuid()) @db.Uuid
  secretHash         String    @unique @map("secret_hash")
  userId             String    @map("user_id") @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  platform           Platform
  resultsEncrypted   String    @map("results_encrypted") @db.Text
  reconnectAccountId String?   @map("reconnect_account_id") @db.Uuid
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([workspaceId, platform])
  @@index([expiresAt])
  @@map("oauth_selections")
}

// ---------------------------------------------------------------- content

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  name        String
  description String?
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  color       String         @default("lime")
  status      CampaignStatus @default(PLANNED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model Post {
  id                  String     @id @default(uuid()) @db.Uuid
  workspaceId         String     @map("workspace_id") @db.Uuid
  authorId            String?    @map("author_id") @db.Uuid
  campaignId          String?    @map("campaign_id") @db.Uuid
  status              PostStatus @default(DRAFT)
  title               String?
  /// Instant the post should publish, always stored UTC.
  scheduledAt         DateTime?  @map("scheduled_at")
  publishedAt         DateTime?  @map("published_at")
  archivedAt          DateTime?  @map("archived_at")
  /// IANA zone the author picked the wall-clock time in.
  timezone            String     @default("UTC")
  recurringScheduleId String?    @map("recurring_schedule_id") @db.Uuid
  /// The workflow step that created this post, when one did. Null for anything
  /// composed by hand. This is the only record of where an automated post came
  /// from — without it a reviewer sees a post with no explicable origin.
  workflowNodeRunId   String?    @map("workflow_node_run_id") @db.Uuid
  /// What approving this post should set in motion: "now" or "queue", recorded
  /// by the workflow step that paused for review so the release it was
  /// configured with survives the pause. Null means approval only marks the
  /// post approved and a person decides when it goes out.
  releaseOnApproval   String?    @map("release_on_approval")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author            User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recurringSchedule RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  workflowNodeRun   WorkflowNodeRun?   @relation(fields: [workflowNodeRunId], references: [id], onDelete: SetNull)
  platforms         PostPlatform[]
  queueItem         QueueItem?
  approvalComments  ApprovalComment[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, archivedAt])
  @@index([workflowNodeRunId])
  @@index([scheduledAt])
  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
  @@map("posts")
}

/// One logical post fans out to one row per target channel, each with its own
/// copy, media and publish result.
model PostPlatform {
  id              String             @id @default(uuid()) @db.Uuid
  postId          String             @map("post_id") @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  socialAccountId String             @map("social_account_id") @db.Uuid
  platform        Platform
  text            String             @default("")
  firstComment    String?            @map("first_comment")
  hashtags        String[]           @default([])
  mentions        String[]           @default([])
  link            String?
  status          PostPlatformStatus @default(PENDING)
  platformPostId  String?            @map("platform_post_id")
  platformUrl     String?            @map("platform_url")
  publishedAt     DateTime?          @map("published_at")
  errorMessage    String?            @map("error_message")
  errorCode       String?            @map("error_code")
  attempts        Int                @default(0)
  /// Stable key that makes republish attempts safe: the adapter is asked to
  /// publish this key at most once. See src/lib/publishing/idempotency.ts.
  idempotencyKey  String             @unique @map("idempotency_key")
  responseMeta    Json               @default("{}") @map("response_meta")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  analytics     PostAnalytics?

  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([workspaceId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@map("post_platforms")
}

model PostMedia {
  id              String   @id @default(uuid()) @db.Uuid
  postPlatformId  String   @map("post_platform_id") @db.Uuid
  mediaAssetId    String   @map("media_asset_id") @db.Uuid
  position        Int      @default(0)
  altText         String?  @map("alt_text")
  /// Frame offset (seconds) chosen as the video cover.
  thumbnailOffset Float?   @map("thumbnail_offset")
  /// Soundtrack, chosen while composing and rendered at publish time. Stored as
  /// intent rather than as a rendered file so changing it costs nothing.
  audioAssetId    String?  @map("audio_asset_id") @db.Uuid
  /// Where in the track the post starts. Songs rarely open on the useful part.
  audioStart      Float?   @map("audio_start")
  createdAt       DateTime @default(now()) @map("created_at")

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a track must not delete the post's media.
  audioAsset   MediaAsset?  @relation("PostMediaSoundtrack", fields: [audioAssetId], references: [id], onDelete: SetNull)

  @@unique([postPlatformId, position])
  @@index([postPlatformId])
  @@index([mediaAssetId])
  @@map("post_media")
}

// ---------------------------------------------------------------- media

model MediaFolder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@index([parentId])
  @@map("media_folders")
}

model MediaTag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    MediaAssetTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("media_tags")
}

model MediaAssetTag {
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  mediaTagId   String   @map("media_tag_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaTag   MediaTag   @relation(fields: [mediaTagId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, mediaTagId])
  @@index([mediaTagId])
  @@map("media_asset_tags")
}

model MediaAsset {
  id               String      @id @default(uuid()) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  folderId         String?     @map("folder_id") @db.Uuid
  uploadedById     String?     @map("uploaded_by_id") @db.Uuid
  filename         String
  mimeType         String      @map("mime_type")
  type             MediaType
  size             Int
  width            Int?
  height           Int?
  /// Seconds, video only.
  duration         Float?
  storageKey       String      @map("storage_key")
  thumbnailKey     String?     @map("thumbnail_key")
  altText          String?     @map("alt_text")
  status           MediaStatus @default(READY)
  usageCount       Int         @default(0) @map("usage_count")
  /// Set when this asset was produced by the editor from another asset.
  derivedFromId    String?     @map("derived_from_id") @db.Uuid
  derivationPreset String?     @map("derivation_preset")
  /// Set when the asset came out of AI image generation.
  aiGenerationId   String?     @map("ai_generation_id") @db.Uuid
  /// Audio only — detected tempo. Null until analysis has run; a track whose
  /// tempo could not be detected keeps null rather than a guessed number.
  bpm              Float?
  /// Beat onsets in seconds from the start of the file, ascending. Audio only.
  ///
  /// The grid, not the tempo, is what clips are cut on: real tracks drift, so
  /// 60/bpm spacing desynchronises within about thirty seconds. It is cached
  /// rather than recomputed because analysis is not reproducible across
  /// machines — mp3 decoders disagree about encoder delay by up to ~26ms — so
  /// this column is the only thing that makes a re-render cut identically.
  ///
  /// Capped at 4096 entries (~34 min at 120bpm); beyond that the tail is
  /// extrapolated from bpm. A social clip only ever uses the head.
  beatGrid         Float[]     @default([]) @map("beat_grid")
  /// The subset of beatGrid that starts a bar. Empty when the analyser could
  /// not place bar one, in which case the renderer treats beat zero as bar one.
  downbeats        Float[]     @default([]) @map("downbeats")
  /// Per-beat onset strength, 0..1, parallel to beatGrid. Lets the renderer
  /// skip a quiet intro and start cutting on the drop.
  beatStrength     Float[]     @default([]) @map("beat_strength")
  beatsPerBar      Int?        @map("beats_per_bar")
  /// `librosa@0.10.2.post1` or `constant-bpm`, so a grid produced by an
  /// analyser the renderer no longer trusts can be re-derived.
  beatAnalyzer     String?     @map("beat_analyzer")
  /// Bumped when the analysis contract changes — sample rate, hop length, the
  /// regularisation rule — independently of the library version.
  beatGridVersion  Int?        @map("beat_grid_version")
  /// Null when never analysed. Distinct from an analysis that ran and found
  /// nothing, which stores an empty grid and a timestamp.
  analysedAt       DateTime?   @map("analysed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder          MediaFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy      User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  derivedFrom     MediaAsset?            @relation("Derivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives     MediaAsset[]           @relation("Derivation")
  tags            MediaAssetTag[]
  postMedia       PostMedia[]
  soundtrackFor   PostMedia[]            @relation("PostMediaSoundtrack")
  aiGeneration    AiGeneration?          @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  aiJobOutputs    AiMediaJob[]           @relation("AiJobOutput")
  workflowOutputs WorkflowNodeRunAsset[]

  @@index([workspaceId])
  @@index([folderId])
  @@index([type])
  @@index([status])
  @@index([aiGenerationId])
  @@index([createdAt])
  /// Lets a beatGridVersion bump find the audio it needs to re-analyse.
  @@index([type, analysedAt])
  @@map("media_assets")
}

