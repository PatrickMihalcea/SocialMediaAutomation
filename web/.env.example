# ─────────────────────────────────────────────────────────────────────────────
# Bridge88 environment
#
# Only NEXT_PUBLIC_* values reach the browser. Every secret below is read in
# server code only (src/lib/env.ts enforces this at import time).
# ─────────────────────────────────────────────────────────────────────────────

# --- core (required) ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/bridge88"
# 32-byte key, base64. Generate: openssl rand -base64 32
AUTH_SECRET="replace-me"
# 32-byte key, base64. Encrypts OAuth tokens at rest. Rotating it invalidates
# every stored social token — users must reconnect. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-me"
# Bearer token used by Vercel Cron to invoke due-post scanning.
CRON_SECRET="replace-me"
# The origin the browser loads. Inlined into the bundle at BUILD time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# The origin the server hands to someone else: OAuth callbacks, signed media
# URLs, invite and reset links. Read at RUNTIME, so pointing this at a tunnel
# needs a restart rather than a rebuild. Leave empty to follow the value above.
#
# Instagram and TikTok fetch the media from this origin themselves, so it has to
# be publicly reachable over HTTPS before either can publish. YouTube uploads the
# bytes directly and works from localhost. Check with: npm run doctor
APP_URL=""

# --- wake the scheduled worker on demand ------------------------------------
# Only relevant if you deploy the worker via .github/workflows/worker.yml (see
# docs/going-live.md) rather than running a persistent one. That schedule
# polls every 5 minutes; without this, confirming "run this workflow" waits up
# to 5 minutes before anything visibly happens. Set these four and the app
# pings GitHub's own workflow_dispatch API the moment there is real work
# queued, instead of waiting for the next tick.
#
# Leave all four empty for local dev, or for a deployment running its own
# persistent worker (npm run worker:prod) — it is a silent no-op either way,
# and the schedule (or the persistent worker) is unaffected.
#
# Create a fine-grained personal access token at
# github.com/settings/personal-access-tokens/new, scoped to ONLY this
# repository, with the single repository permission "Workflows: Read and
# write". This is a separate credential from anything in the workflow file
# itself — that one is secrets GitHub hands to a run it already started; this
# one is what lets the app ask GitHub to start a run at all.
GITHUB_DISPATCH_TOKEN=""
# "owner/repo"
GITHUB_DISPATCH_REPO=""
GITHUB_DISPATCH_WORKFLOW="worker.yml"
GITHUB_DISPATCH_REF="main"

# --- development switches ----------------------------------------------------
# MOCK_MODE=true runs every external integration against its in-repo mock:
# social adapters, AI, storage, billing. No third-party credentials needed.
MOCK_MODE="true"
# in-process | bullmq
QUEUE_DRIVER="in-process"
# Let the web server run jobs itself, for deployments with nowhere to run a
# worker. Leave false and run `npm run worker`: two consumers race the same job.
QUEUE_IN_WEB_SERVER="false"
# local | s3
STORAGE_DRIVER="local"
# mock | openai
AI_PROVIDER="mock"
# inherit | mock | openai | image-use
# Use "mock" during workflow QA to keep real text generation while replacing
# slow, paid image calls with deterministic local PNGs.
AI_IMAGE_PROVIDER="inherit"

# --- redis (QUEUE_DRIVER=bullmq) ---------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- storage (STORAGE_DRIVER=s3; Cloudflare R2 or any S3-compatible) ---------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional CDN/public base for objects served without a signed URL.
S3_PUBLIC_BASE_URL=""

# --- ai (AI_PROVIDER=openai) -------------------------------------------------
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"

# --- ai images via the image-use cli (AI_IMAGE_PROVIDER=image-use) -----------
# Renders against your own ChatGPT/Gemini subscription by running the image-use
# CLI, instead of calling a metered API. It needs a real machine: the script, a
# python3 >= 3.10, and — on the default "web" backend — a Chrome signed in to
# chatgpt.com. That rules out a serverless web tier; run it on a self-hosted
# worker. The subscription is yours, so use this for your own content.
IMAGE_USE_BIN=""
# Only if this machine's python3 is older than 3.10, e.g. "/opt/homebrew/bin/python3.12".
IMAGE_USE_PYTHON=""
# auto | web | codex | gemini | agy — auto prefers the browser path, which
# spares the metered Codex bucket, and falls back to codex when it cannot.
IMAGE_USE_BACKEND="auto"
IMAGE_USE_FORMAT="png"
# Comma-separated saved style/character names to stack onto every prompt
# (`image-use style list`). Empty applies none.
IMAGE_USE_STYLE=""
IMAGE_USE_TIMEOUT_MS="300000"
# The CLI runs one browser generation at a time machine wide; this is how long
# a run may queue behind another before the wrapper gives up on it.
IMAGE_USE_QUEUE_WAIT_MS="120000"
# Every other IMAGE_USE_* knob the CLI documents (IMAGE_USE_PROJECT,
# IMAGE_USE_MODEL, IMAGE_USE_GEMINI_PROFILE …) is passed through to it as-is.
# If the codex backend answers "requires a newer version of Codex", either run
# `npm i -g @openai/codex@latest` or pin an older driver with
# IMAGE_USE_MODEL="gpt-5.5". `image-use doctor` diagnoses the rest.
#
# AI_IMAGE_PROVIDER only sets the DEFAULT of the per-generation choice: the AI
# studio has an API/Codex dropdown and each Image generator step has its own
# default/mock/api/codex setting. On a host that cannot run the CLI (the Vercel
# web tier) leave IMAGE_USE_BIN empty: choosing Codex there queues a job for the
# worker instead of failing. Only the worker needs the two lines above.
#
# Where the worker is thrown away after each run — a GitHub Actions schedule —
# the codex OAuth credential has to outlive the machine. CODEX_AUTH_STORE_KEY is
# an object-storage key holding it, encrypted with TOKEN_ENCRYPTION_KEY, rewritten
# whenever the CLI refreshes the token. CODEX_AUTH_BOOTSTRAP seeds it once with
# the literal contents of ~/.codex/auth.json. Both empty (the default) means the
# machine's own ~/.codex is authoritative, which is right for a laptop.
# See docs/deploying.md step 5.
CODEX_AUTH_STORE_KEY=""
CODEX_AUTH_BOOTSTRAP=""

# --- sign-in oauth -----------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- social platform oauth ---------------------------------------------------
# Each is optional. A platform with no credentials shows as unavailable in the
# Connect dialog instead of failing at the callback.
# Instagram + Facebook share a Meta app (Graph API).
META_APP_ID=""
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# public | unlisted | private. Set this to "private" while testing against a
# real channel — an accidental public upload is not easy to take back.
YOUTUBE_PRIVACY_STATUS="public"

# --- billing (optional; falls back to the mock provider) ---------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# --- email (optional; notifications stay in-app without it) ------------------
RESEND_API_KEY=""
EMAIL_FROM="Bridge88 <no-reply@example.com>"
