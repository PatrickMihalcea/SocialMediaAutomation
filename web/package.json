{
  "name": "bridge88",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbo",
    "build": "node scripts/migrate-on-build.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:image": "node scripts/e2e/generate-image-loop.mjs",
    "worker": "NODE_OPTIONS=--conditions=react-server node --env-file=.env --import tsx --watch src/worker/index.ts",
    "worker:prod": "NODE_OPTIONS=--conditions=react-server node --env-file=.env --import tsx src/worker/index.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "serve": "node scripts/serve.mjs start",
    "serve:stop": "node scripts/serve.mjs stop",
    "serve:status": "node scripts/serve.mjs status",
    "dev:bg": "node scripts/serve.mjs dev",
    "worker:bg": "node scripts/serve.mjs worker",
    "doctor": "node --env-file=.env scripts/doctor.mjs",
    "doctor:production": "node --env-file=.env scripts/doctor.mjs --production",
    "worker:once": "NODE_OPTIONS=--conditions=react-server node --env-file=.env --import tsx src/worker/run-once.ts",
    "migrate:storage": "node --env-file=.env scripts/migrate-storage.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "luxon": "^3.5.0",
    "next": "^15.1.2",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "stripe": "^17.5.0",
    "wavesurfer.js": "^7.12.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
